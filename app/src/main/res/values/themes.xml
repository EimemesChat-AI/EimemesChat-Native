<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Works on Android 5.0 (API 21) and above using AppCompat -->
    <style name="Theme.EimemesChat" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColor">@color/text1</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Theme.EimemesChat.Splash" parent="Theme.EimemesChat">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
